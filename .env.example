# YogyataMitra Environment Configuration
PROJECT_NAME=YogyataMitra
ENVIRONMENT=development
API_V1_STR=/api/v1

# PostgreSQL Configuration
POSTGRES_USER=yogyata_admin
POSTGRES_PASSWORD=yogyata_secure_dev_pass
POSTGRES_SERVER=localhost
# Use 5432 by default, or 5433 if host port 5432 is occupied by native PostgreSQL
POSTGRES_PORT=5433
POSTGRES_DB=yogyatamitra_db

# Optional Direct Override (e.g., for testing or remote DB)
DATABASE_URL_OVERRIDE=
