# ==============================================================================
# YogyataMitra - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' at the repository root and customize as needed.
# For production deployments, consult docs/deployment.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME=YogyataMitra
# Options: development | staging | production
ENVIRONMENT=development
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (Phase 14 & 18 Hardening)
# ------------------------------------------------------------------------------
# Mandatory in production. In development, a marked insecure fallback is used if omitted.
# In production, must be a high-entropy secret (e.g., openssl rand -hex 32)
# and MUST NOT contain 'dev-' or 'insecure'.
SECRET_KEY=

# Access token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo accounts allow auto-seeded mock users (officer, auditor) for demo/dev.
# MUST BE False in production; enforced by pydantic validator.
ENABLE_DEMO_ACCOUNTS=true

# Allowed CORS origins. Comma-separated or JSON list.
# Wildcard '*' is strictly forbidden when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=yogyata_admin
POSTGRES_PASSWORD=replace_me
POSTGRES_SERVER=localhost
# Port 5432 by default, or 5433 if host 5432 is occupied (e.g. Docker container mapped to 5433)
POSTGRES_PORT=5433
POSTGRES_DB=yogyatamitra_db

# Optional direct database URL override (e.g. for testing or external cloud DB)
# When set, overrides individual POSTGRES_* parameters.
DATABASE_URL_OVERRIDE=

# ------------------------------------------------------------------------------
# 4. AI POLICY DISCOVERY & REPAIR (Phase 15 Quarantine Workflow)
# ------------------------------------------------------------------------------
# Options: "mock" (offline deterministic test runner) or "gemini" (Google Gemini API)
AI_PROVIDER=mock
AI_DISCOVERY_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
